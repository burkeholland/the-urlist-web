---
import Layout from "../../layouts/Layout.astro";
import { ShareButton } from "../../components/ShareButton";
import { ListContainer } from "../../components/ListContainer";
import { client } from "../../utils/db";
import { DeleteListButton } from "../../components/DeleteListButton";

const { slug } = Astro.params;

const result = await client.query("SELECT * FROM lists WHERE slug = $1", [
  slug,
]);
const list = result.rows[0];

if (!list) {
  return Astro.redirect("/");
}

// Get the first few links for meta description
const linksResult = await client.query(
  "SELECT title FROM links WHERE list_id = $1 ORDER BY created_at DESC LIMIT 3",
  [list.id]
);
const linkTitles = linksResult.rows.map((row) => row.title).filter(Boolean);
const metaDescription =
  linkTitles.length > 0
    ? `A collection of links including: ${linkTitles.join(", ")}`
    : list.description || "A curated list of links";

function handleListDeleted() {
  window.location.href = "/";
}
---

<Layout title={`${list.title} - The Urlist`} description={metaDescription}>
  <main class="relative">
    <div class="max-w-4xl mx-auto py-8 px-4">
      {/* Enhanced header with gradient background */}
      <div class="relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-teal-50/50 via-transparent to-blue-50/30"></div>
        <header class="relative mb-12 p-8 bg-white/80 backdrop-blur-sm border border-gray-200/50 rounded-3xl shadow-xl shadow-teal-500/5">
          <div class="flex flex-col md:flex-row justify-between items-start gap-8">
            <div class="space-y-6 w-full">
              {/* Title with modern styling */}
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-gradient-to-br from-teal-500 to-blue-500 rounded-2xl flex items-center justify-center shadow-lg flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                </div>
                <div class="flex-1">
                  <h1 class="text-4xl sm:text-5xl font-bold bg-gradient-to-r from-gray-900 to-gray-700 bg-clip-text text-transparent leading-tight">
                    {list.title}
                  </h1>
                  {list.description && (
                    <p class="text-lg text-gray-600 mt-3 leading-relaxed max-w-2xl">
                      {list.description}
                    </p>
                  )}
                </div>
              </div>
              
              {/* Action buttons with modern design */}
              <div class="flex items-center gap-4 flex-wrap">
                <ShareButton client:load url={Astro.url.href} />
                <DeleteListButton client:load listId={list.id} onDeleted={handleListDeleted} />
                
                {/* Additional info badges */}
                <div class="flex items-center gap-2 ml-auto">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    Public
                  </span>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z" />
                    </svg>
                    Shareable
                  </span>
                </div>
              </div>
            </div>
          </div>
        </header>
      </div>

      {/* List container */}
      <ListContainer client:load listId={list.id} />
    </div>
  </main>
</Layout>
