---
// Test page for shadcn/ui Button component
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Button Test</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="bg-white font-inter">
    <div class="container mx-auto p-8">
        <h1 class="text-2xl font-bold mb-8">Button Component Test</h1>
        
        <div id="button-test" class="space-y-4">
            <!-- Buttons will be rendered here by React -->
        </div>
    </div>

    <script type="module">
        import React from 'react';
        import { createRoot } from 'react-dom/client';
        
        // Simple button test component
        function ButtonTest() {
            const [loading1, setLoading1] = React.useState(false);
            const [loading2, setLoading2] = React.useState(false);
            const [loading3, setLoading3] = React.useState(false);
            
            return React.createElement('div', { className: 'space-y-4' }, [
                React.createElement('div', { key: 1, className: 'space-x-4' }, [
                    React.createElement('button', {
                        key: 'primary',
                        className: 'px-6 py-3 rounded-xl font-medium transition-all duration-300 ease-out transform disabled:opacity-50 disabled:cursor-not-allowed hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-opacity-50 flex items-center justify-center gap-2 relative bg-gradient-to-r from-[#15BFAE] to-[#13B0A0] hover:from-[#13B0A0] hover:to-[#03A678] text-white shadow-sm focus:ring-[#15BFAE]/50 hover:shadow-lg hover:shadow-[#15BFAE]/20',
                        onClick: () => {
                            setLoading1(true);
                            setTimeout(() => setLoading1(false), 2000);
                        },
                        disabled: loading1
                    }, [
                        React.createElement('span', {
                            key: 'text',
                            className: `flex items-center gap-2 ${loading1 ? 'opacity-0' : 'opacity-100'}`
                        }, 'Primary Button'),
                        loading1 && React.createElement('div', {
                            key: 'spinner',
                            className: 'absolute inset-0 flex items-center justify-center'
                        }, React.createElement('div', {
                            className: 'animate-spin h-5 w-5 border-2 border-white border-t-transparent rounded-full'
                        }))
                    ]),
                    
                    React.createElement('button', {
                        key: 'secondary',
                        className: 'px-6 py-3 rounded-xl font-medium transition-all duration-300 ease-out transform disabled:opacity-50 disabled:cursor-not-allowed hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-opacity-50 flex items-center justify-center gap-2 relative bg-gray-100 hover:bg-gray-200 text-gray-700 hover:text-gray-900 border border-gray-200 focus:ring-gray-300 hover:border-gray-300',
                        onClick: () => {
                            setLoading2(true);
                            setTimeout(() => setLoading2(false), 2000);
                        },
                        disabled: loading2
                    }, [
                        React.createElement('span', {
                            key: 'text',
                            className: `flex items-center gap-2 ${loading2 ? 'opacity-0' : 'opacity-100'}`
                        }, 'Secondary Button'),
                        loading2 && React.createElement('div', {
                            key: 'spinner',
                            className: 'absolute inset-0 flex items-center justify-center'
                        }, React.createElement('div', {
                            className: 'animate-spin h-5 w-5 border-2 border-gray-700 border-t-transparent rounded-full'
                        }))
                    ]),
                    
                    React.createElement('button', {
                        key: 'destructive',
                        className: 'px-6 py-3 rounded-xl font-medium transition-all duration-300 ease-out transform disabled:opacity-50 disabled:cursor-not-allowed hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-opacity-50 flex items-center justify-center gap-2 relative bg-white hover:bg-red-50 text-red-600 hover:text-red-700 border-2 border-red-200 hover:border-red-300 focus:ring-red-200 hover:shadow-lg hover:shadow-red-100',
                        onClick: () => {
                            setLoading3(true);
                            setTimeout(() => setLoading3(false), 2000);
                        },
                        disabled: loading3
                    }, [
                        React.createElement('span', {
                            key: 'text',
                            className: `flex items-center gap-2 ${loading3 ? 'opacity-0' : 'opacity-100'}`
                        }, 'Destructive Button'),
                        loading3 && React.createElement('div', {
                            key: 'spinner',
                            className: 'absolute inset-0 flex items-center justify-center'
                        }, React.createElement('div', {
                            className: 'animate-spin h-5 w-5 border-2 border-red-600 border-t-transparent rounded-full'
                        }))
                    ])
                ])
            ]);
        }
        
        const root = createRoot(document.getElementById('button-test'));
        root.render(React.createElement(ButtonTest));
    </script>
</body>
</html>